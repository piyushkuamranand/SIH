__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Raw/cached datasets never go into Git (keep folder skeleton only) --
# everything else (model checkpoints, ONNX artifacts, etc.) IS pushed.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**
!data/processed/.gitkeep

# MATLAB Project auto-generated session metadata (opaque, machine-specific, regenerates)
*.prj
resources/project/

