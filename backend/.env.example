# NETRA-DR Node.js Backend — Environment Variables
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# ── Python / Flask AI Service (existing — do NOT modify that service) ────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
AI_SERVICE_URL=http://127.0.0.1:5000
AI_SERVICE_ENDPOINT=/api/quality
AI_SERVICE_TIMEOUT_MS=60000

# ── Storage ──────────────────────────────────────────────────────────────────
# Path to backend/storage/ directory (default: relative to backend root)
STORAGE_ROOT=storage

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Database (not yet implemented — placeholder) ──────────────────────────────
# DATABASE_URL=sqlite://./netra_dr.db
# DATABASE_URL=mongodb://localhost:27017/netra_dr

# ── JWT Auth (not yet implemented — placeholder) ──────────────────────────────
# JWT_SECRET=replace_with_strong_random_secret
# JWT_EXPIRES_IN=8h
